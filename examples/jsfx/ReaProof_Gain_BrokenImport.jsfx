desc:ReaProof Gain BROKEN (missing import)
// Deliberately-broken variant: the imported library does not exist next to
// the file. The battery's static stage must name the missing reference and
// stop - an import that cannot be installed cannot compile, and a render on
// top of that would be asserting on a silently-passthrough chain.

import lib/DoesNotExist.jsfx-inc

slider1:0<-24,24,0.01>Gain (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@slider
gain = db2gain(slider1);

@sample
spl0 *= gain;
spl1 *= gain;
