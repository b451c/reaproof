desc:ReaProof Synth (reference sine instrument)
// GOOD reference subject for the MIDI feed: a minimal monophonic sine synth.
// tags: instrument is the official signal (v6.74+) - the battery auto-skips
// the silence->silence check and drives the subject with the deterministic
// reference note clip instead. Level rides slider1 so the param stages have
// a real, sweepable control.
tags: instrument synthesis

slider1:0.5<0,1,0.01>Level

in_pin:none
out_pin:left output
out_pin:right output

@init
freq = 0; phase = 0; amp = 0; vol = 0.5;

@slider
vol = slider1;

@block
while (midirecv(ofs, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;
  status == 0x90 && msg3 > 0 ? (
    freq = 440 * 2^((msg2 - 69) / 12);
    amp = msg3 / 127 * 0.5;
  ) : (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (
    amp = 0;
  );
);

@sample
phase += 2 * $pi * freq / srate;
phase > 2 * $pi ? phase -= 2 * $pi;
spl0 = sin(phase) * amp * vol;
spl1 = spl0;
