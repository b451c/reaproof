desc:ReaProof Gain (imports a library)
// GOOD reference subject for dependency installation: db2gain() is defined in
// lib/ReaProof_DSP_Lib.jsfx-inc and imported here. A battery that installed
// only the bare subject file would fail the compile proof on a perfectly good
// effect - the import resolves relative to this file, so the referenced
// library must be installed alongside, preserving the relative layout.

import lib/ReaProof_DSP_Lib.jsfx-inc

slider1:0<-24,24,0.01>Gain (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gain = 1;

@slider
gain = db2gain(slider1);

@sample
spl0 *= gain;
spl1 *= gain;
